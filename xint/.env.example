# xint — X Intelligence CLI
# Copy this file to .env and fill in your credentials.
# Required:
X_BEARER_TOKEN=your_x_api_bearer_token_here

# Optional — Grok AI analysis, article fetching, sentiment, x-search
XAI_API_KEY=your_xai_api_key_here

# Optional — xAI Management API (collections management)
XAI_MANAGEMENT_API_KEY=your_management_api_key_here

# Optional — X OAuth 2.0 PKCE (bookmarks, likes, following)
X_CLIENT_ID=your_oauth_client_id_here

# Optional — Package API
XINT_PACKAGE_API_KEY=
