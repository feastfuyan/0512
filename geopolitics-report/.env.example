# geopolitics-report Environment Variables
# =========================================
# Copy this file to .env and fill in values as needed.
# Never commit .env files to version control.

# EU Sanctions Download Token (public, but can be overridden if EU rotates the URL)
# Default (already works): dG9rZW5hcHBsaWNhdGlvbjE
EU_SANCTIONS_TOKEN=

# LLM API Keys (for dispatch-runner.mjs backends)
# Set at least one for the backend you intend to use:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
