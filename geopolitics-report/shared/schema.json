{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiningClaw Geopolitics Report Data Schema v3.0",
  "description": "Cross-agent payload contract for 03-geopolitics-report",
  "type": "object",
  "required": ["report_id", "source_doc", "chapters", "chart_specs"],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^MCG-GEO-[0-9]{8}-[A-Z0-9]+-[0-9]{3}$"
    },
    "source_doc": { "type": "string" },
    "source_total_lines": { "type": "integer" },
    "language": { "type": "string", "enum": ["en", "zh"] },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "numeric_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fact", "value", "src_line", "src_quote"],
              "properties": {
                "fact": { "type": "string" },
                "value": { "type": "string" },
                "src_line": { "type": "integer" },
                "src_quote": { "type": "string", "minLength": 10 }
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["caption", "headers", "rows"],
              "properties": {
                "caption": { "type": "string" },
                "headers": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": "array" } },
                "src_lines": { "type": "array", "items": { "type": "integer" } }
              }
            }
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "src_line"],
              "properties": {
                "text": { "type": "string" },
                "src_line": { "type": "integer" }
              }
            }
          },
          "missing": { "type": "array" }
        }
      }
    },
    "chart_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "chart_type", "title", "source_note", "encoding", "data"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "chart_type": { "type": "string", "enum": ["multi-series-line", "grouped-bar", "signed-bar", "horizontal-bar"] },
          "title": { "type": "string" },
          "source_note": { "type": "string" },
          "encoding": {
            "type": "object",
            "required": ["x_field", "value_field"],
            "properties": {
              "x_field": { "type": "string" },
              "value_field": { "type": "string" },
              "series_field": { "type": "string" }
            }
          },
          "unit": { "type": "string" },
          "src_lines": { "type": "array", "items": { "type": "integer" } },
          "data": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
