{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "DataCollectorOutput": {
    "type": "object",
    "required": ["report_id", "report_meta", "experts", "commodities", "mci_index"],
    "properties": {
      "report_id": {
        "type": "string",
        "pattern": "^MCE-EXPERT-[0-9]{8}-[A-Z0-9]+-[0-9]{3}$"
      },
      "report_meta": {
        "type": "object",
        "required": ["title", "period", "date", "version"],
        "properties": {
          "title": { "type": "string" },
          "period": { "type": "string", "pattern": "^[0-9]{4}年Q[1-4]$" },
          "date": { "type": "string", "format": "date" },
          "version": { "type": "string", "pattern": "^V[0-9]+\\.[0-9]+$" },
          "core_topic": { "type": "string" }
        }
      },
      "experts": {
        "type": "array",
        "minItems": 6,
        "items": {
          "type": "object",
          "required": ["name", "title_en", "title_zh", "org"],
          "properties": {
            "name": { "type": "string" },
            "title_en": { "type": "string" },
            "title_zh": { "type": "string" },
            "org": { "type": "string" }
          }
        }
      },
      "commodities": {
        "type": "object",
        "required": ["cu", "fe", "au", "li", "ni", "ree"],
        "properties": {
          "cu": { "$ref": "#/definitions/CommodityData" },
          "fe": { "$ref": "#/definitions/CommodityData" },
          "au": { "$ref": "#/definitions/CommodityData" },
          "li": { "$ref": "#/definitions/CommodityData" },
          "ni": { "$ref": "#/definitions/CommodityData" },
          "ree": { "$ref": "#/definitions/CommodityData" }
        }
      },
      "mci_index": {
        "type": "object",
        "required": ["total_score", "sentiment", "dimensions"],
        "properties": {
          "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "sentiment": { "type": "string" },
          "dimensions": {
            "type": "object",
            "required": ["price_momentum", "inventory_cycle", "capital_flow", "geopolitical_risk", "esg_events"],
            "additionalProperties": {
              "type": "object",
              "required": ["score", "weight", "description"],
              "properties": {
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                "description": { "type": "string" }
              }
            }
          }
        }
      },
      "policy_events": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["flag", "title", "date", "impact", "description"],
          "properties": {
            "flag": { "type": "string" },
            "title": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "impact": { "type": "string", "enum": ["pos", "neg", "neu"] },
            "description": { "type": "string" }
          }
        }
      },
      "regional_markets": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["name_en", "name_zh", "risk_level", "key_trends"],
          "properties": {
            "name_en": { "type": "string" },
            "name_zh": { "type": "string" },
            "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
            "key_trends": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["chapter", "fact", "needed"],
          "properties": {
            "chapter": { "type": "string" },
            "fact": { "type": "string" },
            "needed": { "type": "string" }
          }
        }
      }
    }
  },
  "RubricReviewerOutput": {
    "type": "object",
    "required": ["report_id", "round", "timestamp", "scores", "weak_items", "pass", "overall_score"],
    "properties": {
      "report_id": { "type": "string" },
      "round": { "type": "integer", "minimum": 1, "maximum": 3 },
      "timestamp": { "type": "string", "format": "date-time" },
      "scores": {
        "type": "object",
        "required": ["data_integrity", "logical_consistency", "language_quality", "structure_compliance", "expert_citation_quality", "professional_depth"],
        "additionalProperties": {
          "type": "object",
          "required": ["score", "weight", "details"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 10 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": { "type": "string" },
            "target_agent": { "type": "string" }
          }
        }
      },
      "weak_items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["dimension", "score", "target_agent", "reviewer_comment"],
          "properties": {
            "dimension": { "type": "string" },
            "score": { "type": "number" },
            "target_agent": { "type": "string" },
            "reviewer_comment": { "type": "string" }
          }
        }
      },
      "pass": { "type": "boolean" },
      "overall_score": { "type": "number", "minimum": 0, "maximum": 10 }
    }
  },
  "definitions": {
    "CommodityData": {
      "type": "object",
      "required": ["name_en", "name_zh", "current_price", "price_unit", "rating", "drivers", "supply_demand", "risks", "forecast"],
      "properties": {
        "name_en": { "type": "string" },
        "name_zh": { "type": "string" },
        "current_price": { "type": "number" },
        "price_unit": { "type": "string" },
        "rating": { "type": "string", "enum": ["bull", "neutral", "bear"] },
        "drivers": { "type": "array", "items": { "type": "string" } },
        "supply_demand": {
          "type": "object",
          "required": ["supply_trend", "demand_trend", "inventory_level"],
          "properties": {
            "supply_trend": { "type": "string", "enum": ["tight", "balanced", "excess", "stable"] },
            "demand_trend": { "type": "string", "enum": ["strong", "weak", "moderate"] },
            "inventory_level": { "type": "string", "enum": ["low", "high", "balanced"] }
          }
        },
        "risks": { "type": "array", "items": { "type": "string" } },
        "forecast": {
          "type": "object",
          "required": ["Q+1", "Q+2", "Q+3", "Q+4"],
          "properties": {
            "Q+1": { "type": "number" },
            "Q+2": { "type": "number" },
            "Q+3": { "type": "number" },
            "Q+4": { "type": "number" }
          }
        }
      }
    }
  }
}